diff --git a/arch/arm/boot/dts/overlays/boe-tv070wxm-overlay.dts b/arch/arm/boot/dts/overlays/boe-tv070wxm-overlay.dts
new file mode 100644
index 000000000000..f85b06d67026
--- /dev/null
+++ b/arch/arm/boot/dts/overlays/boe-tv070wxm-overlay.dts
@@ -0,0 +1,208 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Device Tree Overlay: BOE TV070WXM-TV1-3GP1 on Raspberry Pi CM4
+ * Copyright (C) 2026 Scandent LLC. <richard@scandent.com>
+ *
+ * Panel: BOE TV070WXM-TV1-3GP1, JD9366AB DDIC, 4-lane MIPI DSI
+ * Touch: FocalTech FTS3528, I2C @ 0x38
+ * PWM:   Texas Instruments TPS92380 Backlight LED Driver
+ *
+ * Default wiring:
+ *   DSI RST        = GPIO27
+ *   Backlight PWM  = GPIO12  (PWM0 ch0)
+ *   Touch SCL      = GPIO23  (I2C6)
+ *   Touch SDA      = GPIO22  (I2C6)
+ *   Touch INT      = GPIO21
+ *   Touch RST      = GPIO26
+ *
+ * Usage in /boot/firmware/config.txt:
+ *   display_auto_detect=0
+ *   dtoverlay=vc4-kms-v3d
+ *   dtoverlay=boe-tv070wxm
+ *
+ * Notes on Steam Deck equivalence:
+ * - Touch IRQ in Steam Deck ACPI is Level + ActiveLow + PullUp.
+ * - Steam Deck ACPI exposes _DSW/_PS0/_PS3/_DSM on the touch device,
+ *   but there is no 1:1 overlay-only DT equivalent for those methods.
+ *   'wakeup-source' below is the closest useful DT-side hint.
+ * - The Steam Deck uses the O2Micro OZ536 Backlight LED Driver. This is not
+ *   avaliable from public distributors, so we are using the Texas Instruments
+ *   TPS92380 Backlight LED Driver. Therefore, the ACPI brightness table in the
+ *   steam deck is non-equivalent and we must use our own.
+ * - A reported Steam Deck LCD PWM frequency is ~1100 Hz below full brightness,
+ *   which corresponds to a period of about 909091 ns. We expect our dimming
+ *   ratio to exceed that of the "Up to 100:1 true analog dimming ratio" that
+ *   O2Micro publicly documents for the OZ536.
+ * - The steam deck panel is natively portrait and must be rotated either 90 or
+ *   270 degrees into landscape. We elect to rotate 270 degrees. This only
+ *   affects the ptty. The X11 server needs a configuration file for both touch
+ *   and the panel. The steam deck itself has changes elsewhere in the kernel
+ *   and userspace to handle this. The kernel code checks for the motherboard,
+ *   which we cannot replicate.
+ */
+
+/dts-v1/;
+/plugin/;
+
+/ {
+    compatible = "brcm,bcm2711";
+
+    /* DSI host + panel */
+    fragment@0 {
+        target = <&dsi1>;
+        __overlay__ {
+            status = "okay";
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            port {
+                dsi1_out_port: endpoint {
+                    remote-endpoint = <&panel_dsi_in>;
+                    data-lanes = <0 1 2 3>;
+                };
+            };
+
+            panel: panel@0 {
+                compatible = "boe,tv070wxm-tv1-3gp1";
+                reg = <0>;
+		rotation = <270>;
+
+                reset-gpios = <&gpio 27 1>; /* GPIO27, active low */
+
+                vdd-supply = <&panel_vdd>;
+                vccio-supply = <&panel_vccio>;
+
+                backlight = <&panel_backlight>;
+
+                port {
+                    panel_dsi_in: endpoint {
+                        remote-endpoint = <&dsi1_out_port>;
+                        data-lanes = <0 1 2 3>;
+                    };
+                };
+            };
+        };
+    };
+
+    /* GPIO pin muxing / bias */
+    fragment@1 {
+        target = <&gpio>;
+        __overlay__ {
+            pwm_pins: pwm_pins {
+                brcm,pins = <12>;
+                brcm,function = <4>; /* ALT0 = PWM0 */
+            };
+
+            touch_int_pin: touch_int_pin {
+                brcm,pins = <21>;
+                brcm,function = <0>; /* input */
+                brcm,pull = <2>;     /* pull-up */
+            };
+
+            touch_rst_pin: touch_rst_pin {
+                brcm,pins = <26>;
+                brcm,function = <1>; /* output */
+                brcm,pull = <0>;     /* no pull */
+            };
+        };
+    };
+
+    /* PWM controller */
+    fragment@2 {
+        target = <&pwm>;
+        __overlay__ {
+            pinctrl-names = "default";
+            pinctrl-0 = <&pwm_pins>;
+            status = "okay";
+        };
+    };
+
+    /* Backlight driver */
+    fragment@3 {
+        target-path = "/";
+        __overlay__ {
+            panel_backlight: panel_backlight {
+                compatible = "pwm-backlight";
+                pwms = <&pwm 0 909091 0>;
+                brightness-levels = <0 4 8 16 32 64 128 192 255>;
+                default-brightness-level = <6>;
+
+                status = "okay";
+            };
+        };
+    };
+
+    /* Touchscreen on I2C6 – CM4 only */
+    fragment@4 {
+        target = <&i2c6>;
+        __overlay__ {
+            #address-cells = <1>;
+            #size-cells = <0>;
+            status = "okay";
+	    clock-frequency = <400000>;
+
+
+
+            touchscreen: fts3528@38 {
+                compatible = "hid-over-i2c";
+                reg = <0x38>;
+                //panel = <&panel>;
+
+                pinctrl-names = "default";
+                pinctrl-0 = <&touch_int_pin &touch_rst_pin>;
+
+                interrupt-parent = <&gpio>;
+                interrupts = <21 8>; /* GPIO21, IRQ_TYPE_LEVEL_LOW */
+
+                wakeup-source;
+                hid-descr-addr = <0x0000>;
+            };
+        };
+    };
+
+    /*
+     * Touch reset held deasserted.
+     * gpios third cell = 0 => active high
+     */
+    fragment@5 {
+        target = <&gpio>;
+        __overlay__ {
+            touch_reset_hog: touch-reset-hog {
+                gpio-hog;
+                gpios = <26 0>; /* GPIO26, active high */
+                output-high;
+                line-name = "touch-reset";
+            };
+        };
+    };
+
+    /* Fixed regulators for the panel (always-on rails) */
+    fragment@6 {
+        target-path = "/";
+        __overlay__ {
+            panel_vdd: regulator-panel-vdd {
+                compatible = "regulator-fixed";
+                regulator-name = "panel-vdd";
+                regulator-min-microvolt = <3300000>;
+                regulator-max-microvolt = <3300000>;
+                /* No gpio = always on. Remove the comment and add a gpio
+                   later if you get a real power-switch GPIO. */
+            };
+
+            panel_vccio: regulator-panel-vccio {
+                compatible = "regulator-fixed";
+                regulator-name = "panel-vccio";
+                regulator-min-microvolt = <1800000>;
+                regulator-max-microvolt = <1800000>;
+            };
+        };
+    };
+
+    /* Set I2C6 to use GPIO 22 and 23 */
+    fragment@7 {
+        target = <&i2c6_pins>;
+        __overlay__ {
+            brcm,pins = <22 23>;
+        };
+    };
+};
