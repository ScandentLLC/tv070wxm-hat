diff --git a/drivers/gpu/drm/panel/panel-boe-tv070wxm.c b/drivers/gpu/drm/panel/panel-boe-tv070wxm.c
new file mode 100644
index 000000000000..232fbd0d5f50
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-boe-tv070wxm.c
@@ -0,0 +1,504 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * BOE TV070WXM-TV1-3GP1 7" 800x1280 MIPI DSI panel driver
+ *
+ * Display driver IC: Jadard JD9366AB-3
+ * Panel: BOE TV070WXM-TV1-3GP1, 7" IPS, 800x1280, 4-lane MIPI DSI
+ * Touch: FocalTech FTS3528 (separate I2C device, not handled here)
+ *
+ * Init sequence from BOE-provided YMK initialisation table for the
+ * TV070WXM-TV1-3GP1 panel variant.
+ *
+ * The JD9366AB uses page-switching register 0xE0 and password unlock
+ * sequence (E1=0x93, E2=0x65, E3=0xF8) to access extended registers.
+ *
+ * Copyright (c) 2026, Scandent LLC
+ *
+ * Author: Richard Yao <richard@scandent.com>
+ */
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_print.h>
+
+#include <linux/gpio/consumer.h>
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+struct boe_panel {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	enum drm_panel_orientation orientation;
+	struct regulator *vdd;
+	struct regulator *vccio;
+	struct gpio_desc *reset;
+};
+
+#define JD9366AB_SWITCH_PAGE	0xe0
+
+#define jd9366ab_switch_page(ctx, page) \
+	mipi_dsi_dcs_write_seq_multi(ctx, JD9366AB_SWITCH_PAGE, (page))
+
+static void jd9366ab_unlock(struct mipi_dsi_multi_context *ctx)
+{
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xe1, 0x93);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xe2, 0x65);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xe3, 0xf8);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x80, 0x03);
+}
+
+static inline struct boe_panel *to_boe_panel(struct drm_panel *panel)
+{
+	return container_of(panel, struct boe_panel, panel);
+}
+
+static int boe_tv070wxm_init(struct boe_panel *boe)
+{
+	struct mipi_dsi_multi_context ctx = { .dsi = boe->dsi };
+
+	/*
+	 * Pre-init: DSI/PHY configuration registers (Jadard extended).
+	 * YMK type 0x39 = DCS Long Write; mipi_dsi_dcs_write_seq_multi
+	 * selects DCS Long Write (0x39) for 2+ parameter bytes.
+	 */
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0xB7, 0x10, 0x02);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0xBD, 0x00, 0x00);
+
+	/* Page 0 — unlock */
+	jd9366ab_switch_page(&ctx, 0x00);
+	jd9366ab_unlock(&ctx);
+
+	/* --- Page 1: VCOM, power, TCON, gamma --- */
+	jd9366ab_switch_page(&ctx, 0x01);
+
+	/* VCOM */
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x01, 0x8C);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x03, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x04, 0xA8);
+
+	/* Gamma power: VGMP, VGMN */
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x17, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x18, 0xB1);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x19, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x1A, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x1B, 0xB1);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x1C, 0x01);
+
+	/* Gate power */
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x1F, 0x3E);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x20, 0x2D);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x21, 0x2D);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x22, 0x7E);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x26, 0xDF);
+
+	/* SETPANEL: SS=1, BGR=1 */
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x37, 0x19);
+
+	/* RGBCYC */
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x38, 0x05);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x39, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x3A, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x3C, 0x78);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x3D, 0xFF);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x3E, 0xFF);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x3F, 0xFF);
+
+	/* TCON */
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x40, 0x06);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x41, 0xA0);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x43, 0x08);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x44, 0x09);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x45, 0x28);
+
+	/* Power voltage */
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x55, 0x0F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x57, 0x89);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x58, 0x0A);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x59, 0x0A);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x5A, 0x28);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x5B, 0x19);
+
+	/* Positive gamma */
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x5D, 0x7C);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x5E, 0x67);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x5F, 0x58);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x60, 0x4C);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x61, 0x47);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x62, 0x38);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x63, 0x3A);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x64, 0x20);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x65, 0x36);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x66, 0x34);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x67, 0x32);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x68, 0x4E);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x69, 0x3B);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x6A, 0x40);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x6B, 0x31);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x6C, 0x2B);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x6D, 0x1D);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x6E, 0x0B);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x6F, 0x00);
+
+	/* Negative gamma */
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x70, 0x7C);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x71, 0x67);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x72, 0x58);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x73, 0x4C);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x74, 0x47);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x75, 0x38);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x76, 0x3A);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x77, 0x20);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x78, 0x36);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x79, 0x34);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x7A, 0x32);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x7B, 0x4E);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x7C, 0x3B);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x7D, 0x40);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x7E, 0x31);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x7F, 0x2B);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x80, 0x1D);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x81, 0x0B);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x82, 0x00);
+
+	/* --- Page 2: GIP --- */
+	jd9366ab_switch_page(&ctx, 0x02);
+
+	/* GIP_L pin mapping */
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x00, 0x45);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x01, 0x45);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x02, 0x44);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x03, 0x44);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x04, 0x47);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x05, 0x47);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x06, 0x46);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x07, 0x46);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x08, 0x40);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x09, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x0A, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x0B, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x0C, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x0D, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x0E, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x0F, 0x41);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x10, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x11, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x12, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x13, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x14, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x15, 0x1F);
+
+	/* GIP_R pin mapping */
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x16, 0x45);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x17, 0x45);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x18, 0x44);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x19, 0x44);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x1A, 0x47);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x1B, 0x47);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x1C, 0x46);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x1D, 0x46);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x1E, 0x40);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x1F, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x20, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x21, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x22, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x23, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x24, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x25, 0x41);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x26, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x27, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x28, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x29, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x2A, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x2B, 0x1F);
+
+	/* GIP timing */
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x58, 0x40);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x5B, 0x10);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x5C, 0x06);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x5D, 0x20);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x5E, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x5F, 0x02);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x63, 0x66);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x64, 0x66);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x67, 0x32);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x68, 0x08);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x69, 0x66);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x6A, 0x66);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x6B, 0x08);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x6C, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x6D, 0x04);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x6E, 0x04);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x6F, 0x88);
+
+	/* --- Page 3 --- */
+	jd9366ab_switch_page(&ctx, 0x03);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x98, 0x3E);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x9B, 0x04);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0xAF, 0x00);
+
+	/* --- Page 4 --- */
+	jd9366ab_switch_page(&ctx, 0x04);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x09, 0x10);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x0E, 0x48);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x2C, 0x2B);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x2F, 0x44);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x36, 0x2A);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x49, 0xFF);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x51, 0xFF);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x9A, 0x21);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x9B, 0x25);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x9C, 0x26);
+
+	/* --- Page 0: watchdog, CABC, tear on, sleep out, display on --- */
+	jd9366ab_switch_page(&ctx, 0x00);
+
+	/* Watchdog timer */
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0xE6, 0x02);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0xE7, 0x06);
+
+	/* CABC / brightness */
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x51, 0xFF);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x53, 0x2C);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x55, 0x00);
+
+	/* Page 3: additional setting */
+	jd9366ab_switch_page(&ctx, 0x03);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0xAB, 0x0E);
+
+	/* Back to Page 0 */
+	jd9366ab_switch_page(&ctx, 0x00);
+
+	/* Enable tearing effect output */
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x35, 0x00);
+
+	/* Sleep out */
+	mipi_dsi_dcs_exit_sleep_mode_multi(&ctx);
+	mipi_dsi_msleep(&ctx, 120);
+
+	/* Display on */
+	mipi_dsi_dcs_set_display_on_multi(&ctx);
+
+	return ctx.accum_err;
+}
+
+static int boe_tv070wxm_disable(struct drm_panel *panel)
+{
+	struct boe_panel *boe = to_boe_panel(panel);
+	struct mipi_dsi_multi_context ctx = { .dsi = boe->dsi };
+
+	mipi_dsi_dcs_set_display_off_multi(&ctx);
+	mipi_dsi_msleep(&ctx, 50);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&ctx);
+	mipi_dsi_msleep(&ctx, 120);
+
+	return ctx.accum_err;
+}
+
+static int boe_tv070wxm_prepare(struct drm_panel *panel)
+{
+	struct boe_panel *boe = to_boe_panel(panel);
+	int ret;
+
+	ret = regulator_enable(boe->vccio);
+	if (ret)
+		return ret;
+
+	ret = regulator_enable(boe->vdd);
+	if (ret)
+		goto err_vdd;
+
+	/*
+	 * Power-on sequence per BOE spec Table 14 and JD9366 §9.5.2:
+	 * 1. Power rails ramp (no limit)
+	 * 2. Wait tRPWIRES >= 5ms
+	 * 3. Assert reset low for tRESETL >= 10us
+	 * 4. De-assert reset, wait tRESETH >= 5ms
+	 *
+	 * Actually following these using usleep_range() can cause the panel to
+	 * fail to work following a reboot on the Raspberry Pi 5, so we
+	 * loosened the timings to these values that we empirically determined
+	 * to be reliable.
+	 */
+	msleep(5);
+
+	gpiod_set_value_cansleep(boe->reset, 1);
+	msleep(20);
+
+	gpiod_set_value_cansleep(boe->reset, 0);
+	msleep(50);
+
+	ret = boe_tv070wxm_init(boe);
+	if (ret)
+		goto err_init;
+
+	return 0;
+
+err_init:
+	gpiod_set_value_cansleep(boe->reset, 1);
+	regulator_disable(boe->vdd);
+err_vdd:
+	regulator_disable(boe->vccio);
+	return ret;
+}
+
+static int boe_tv070wxm_unprepare(struct drm_panel *panel)
+{
+	struct boe_panel *boe = to_boe_panel(panel);
+
+	gpiod_set_value_cansleep(boe->reset, 1);
+	msleep(120);
+
+	regulator_disable(boe->vdd);
+	regulator_disable(boe->vccio);
+
+	return 0;
+}
+
+/*
+ * Display timing from JD9366AB EVB settings matching BOE spec Table 13:
+ *   HS=20, HBP=30, HFP=30 => htotal=880
+ *   VS=4,  VBP=9,  VFP=30 => vtotal=1323
+ *   clock = 880 * 1323 * 60 = 69,854 kHz
+ */
+static const struct drm_display_mode boe_tv070wxm_mode = {
+	.clock		= 69854,
+	.hdisplay	= 800,
+	.hsync_start	= 800 + 30,
+	.hsync_end	= 800 + 30 + 20,
+	.htotal		= 800 + 30 + 20 + 30,
+	.vdisplay	= 1280,
+	.vsync_start	= 1280 + 30,
+	.vsync_end	= 1280 + 30 + 4,
+	.vtotal		= 1280 + 30 + 4 + 9,
+	.width_mm	= 94,
+	.height_mm	= 151,
+	.type		= DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int boe_tv070wxm_get_modes(struct drm_panel *panel,
+				  struct drm_connector *connector)
+{
+	struct boe_panel *boe = to_boe_panel(panel);
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &boe_tv070wxm_mode);
+	if (!mode) {
+		DRM_DEV_ERROR(&boe->dsi->dev,
+			      "failed to add mode %ux%u@%u\n",
+			      boe_tv070wxm_mode.hdisplay,
+			      boe_tv070wxm_mode.vdisplay,
+			      drm_mode_vrefresh(&boe_tv070wxm_mode));
+		return -ENOMEM;
+	}
+
+	drm_mode_set_name(mode);
+	drm_mode_probed_add(connector, mode);
+
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+
+	return 1;
+}
+
+static enum drm_panel_orientation
+boe_tv070wxm_get_orientation(struct drm_panel *panel)
+{
+	return to_boe_panel(panel)->orientation;
+}
+
+static const struct drm_panel_funcs boe_tv070wxm_funcs = {
+	.disable	= boe_tv070wxm_disable,
+	.unprepare	= boe_tv070wxm_unprepare,
+	.prepare	= boe_tv070wxm_prepare,
+	.get_modes	= boe_tv070wxm_get_modes,
+	.get_orientation = boe_tv070wxm_get_orientation,
+};
+
+static int boe_tv070wxm_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct boe_panel *boe;
+	int ret;
+
+	boe = devm_kzalloc(dev, sizeof(*boe), GFP_KERNEL);
+	if (!boe)
+		return -ENOMEM;
+
+	boe->vdd = devm_regulator_get(dev, "vdd");
+	if (IS_ERR(boe->vdd))
+		return dev_err_probe(dev, PTR_ERR(boe->vdd),
+				     "Failed to get vdd supply\n");
+
+	boe->vccio = devm_regulator_get(dev, "vccio");
+	if (IS_ERR(boe->vccio))
+		return dev_err_probe(dev, PTR_ERR(boe->vccio),
+				     "Failed to get vccio supply\n");
+
+	boe->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(boe->reset))
+		return dev_err_probe(dev, PTR_ERR(boe->reset),
+				     "Failed to get reset GPIO\n");
+
+	ret = of_drm_get_panel_orientation(dev->of_node, &boe->orientation);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to get orientation\n");
+
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST | MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_NO_EOT_PACKET | MIPI_DSI_MODE_LPM;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->lanes = 4;
+
+	drm_panel_init(&boe->panel, dev, &boe_tv070wxm_funcs,
+		       DRM_MODE_CONNECTOR_DSI);
+
+	/* Without this, there is no DSI communication */
+	boe->panel.prepare_prev_first = true;
+
+	ret = drm_panel_of_backlight(&boe->panel);
+	if (ret)
+		return ret;
+
+	drm_panel_add(&boe->panel);
+
+	mipi_dsi_set_drvdata(dsi, boe);
+	boe->dsi = dsi;
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&boe->panel);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void boe_tv070wxm_remove(struct mipi_dsi_device *dsi)
+{
+	struct boe_panel *boe = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&boe->panel);
+}
+
+static const struct of_device_id boe_tv070wxm_of_match[] = {
+	{ .compatible = "boe,tv070wxm-tv1-3gp1" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, boe_tv070wxm_of_match);
+
+static struct mipi_dsi_driver boe_tv070wxm_driver = {
+	.probe	= boe_tv070wxm_probe,
+	.remove	= boe_tv070wxm_remove,
+	.driver	= {
+		.name		= "panel-boe-tv070wxm",
+		.of_match_table	= boe_tv070wxm_of_match,
+	},
+};
+module_mipi_dsi_driver(boe_tv070wxm_driver);
